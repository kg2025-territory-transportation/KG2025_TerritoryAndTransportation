                "EN" : "common garden : 1\ngreen area : 1\nski storeroom : 1\ncar parking lot : 1\nseniors : 1\nmulti-family house : 1\nquiet location : 1\nfamilies : 1\nyoung persons : 1\nFrench : 1\n",
