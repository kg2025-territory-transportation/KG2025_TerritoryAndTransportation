            "location" : {
                "coordinate" : {
                    "latitude" : 46.0473526736072,
                    "longitude" : 11.3915348052979,
                    "altitude" : 0,
                    "srsName" : "WGS84"
                },
                "addresses" : {
                    "IT" : {
