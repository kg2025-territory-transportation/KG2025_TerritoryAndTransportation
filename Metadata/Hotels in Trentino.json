                    }
                }
            },
            "contact" : {
                "name" : {
                    "IT" : "Stefano Montibeller"
                },
                "phone" : "(0039) 0461 1851508",
                "fax" : "(0039) 0461 1851419",
                "mail" : "info@coronatahaus.it",
                "url" : "http://www.coronatahaus.it"
            },
            "seatingCapacity" : {},
            "accessibility" : {},
            "timetable" : {},
            "pric" : {}
        },
        "objData" : {
            "objectUri" : "universiadi2013@feb07388-cc9b-4717-adbd-4d8eab8f4bcb",
            "entityUri" : null,
            "name" : {
                "IT" : "CORONATA HAUS"
            },
            "description" : {
                "EN" : "Surrounded by the gardens of Roncegno Terme, the Coronata Haus is a B&B in the Alpine style.\nIt offers a sauna, a sun terrace and rooms with mountain views, free Wi-Fi and private parking.\nAll rooms have wood floors, light wood furniture, a flat screen TV, a minibar, a private bathroom with shower and hairdryer, and some rooms have a balcony.\nYou can start your day with a sweet and savory breakfast buffet with homemade cakes, hot drinks and cold cuts.\nIt is 12 km from the Ski Centre Panarota 2002, a 15-minte drive from Lake Levico and a 40 minute drive from Trento.",
                "IT" : "Il Coronata Haus Garnì rinverdisce sapientemente il passato di casa signorile edificata tra lo spandersi rigoglioso delle vigne e delle campagne in un sito, la Vazzena, abitato da antica data.\n\nL’edificio è adagiato sul pendio che si diparte dalla vecchia strada Borgo - Roncegno.\nLa posizione felicemente sopraelevata sul fondovalle è caratteristica di quest’area pedemontana; diversi sono infatti gli edifici raffinati e i casali che partendo da Onea di Borgo si snodano da un poggio all’altro fin su a Roncegno, all’ex casa Hippoliti titolari un tempo del feudo dei Montebello.\n\nDalla terrazza di Coronata Haus lo sguardo è attratto subito dalla suggestiva catena di monti che uniscono la tristemente famosa Ortigara alla caratteristica cuspide piramidale di cima Dodici.\n\nPiù sotto la vista spazia sulla piana impreziosita da un esteso vigneto di pregiate uve bianche e dalla riserva naturale meta di appassionati visitatori.\n\nL’ameno e il familiare che si palesano all’ospite temperano gradevolmente il selvaggio polmone verde che sale dietro la casa verso la chiesetta di San Nicolò e il colle di Montebello, sede dell’omonimo castello oggi inesistente.\n\nLa nascita di Coronata Haus Garnì ha il merito di aver recuperato un edificio prezioso per la sua storia, richiamando altresì in vita valori di laboriosità, amore alla terra, sapienza agreste che caratterizzarono il luogo nei secoli passati.\n"
            },
            "longDescription" : {},
