    <owl:Class rdf:about="https://schema.org/Project">
        <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
        <rdfs:comment xml:lang="en">An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.
Use properties from &lt;a class=&quot;localLink&quot; href=&quot;/Organization&quot;&gt;Organization&lt;/a&gt;, &lt;a class=&quot;localLink&quot; href=&quot;/subOrganization&quot;&gt;subOrganization&lt;/a&gt;/&lt;a class=&quot;localLink&quot; href=&quot;/parentOrganization&quot;&gt;parentOrganization&lt;/a&gt; to indicate project sub-structures.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://pending.schema.org/Project"/>
        <rdfs:label xml:lang="en">Project</rdfs:label>
    </owl:Class>
    


