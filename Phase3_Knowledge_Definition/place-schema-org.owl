        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">A theater or other performing art center.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/PerformingArtsTheater"/>
        <rdfs:label xml:lang="en">PerformingArtsTheater</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Place -->

    <owl:Class rdf:about="https://schema.org/Place">
