        <rdfs:isDefinedBy rdf:resource="https://schema.org/GovernmentBuilding"/>
        <rdfs:label xml:lang="en">GovernmentBuilding</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/HinduTemple -->

    <owl:Class rdf:about="https://schema.org/HinduTemple">
