        <rdfs:comment xml:lang="en">One of the continents (for example, Europe or Africa).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Continent"/>
        <rdfs:label xml:lang="en">Continent</rdfs:label>
    </owl:Class>
    


