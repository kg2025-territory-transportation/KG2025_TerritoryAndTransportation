        <rdfs:comment xml:lang="en">A museum.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Museum"/>
        <rdfs:label xml:lang="en">Museum</rdfs:label>
    </owl:Class>
    


