        <rdfs:subClassOf rdf:resource="https://schema.org/BodyOfWater"/>
        <rdfs:comment xml:lang="en">An ocean (for example, the Pacific).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/OceanBodyOfWater"/>
        <rdfs:label xml:lang="en">OceanBodyOfWater</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Park -->

    <owl:Class rdf:about="https://schema.org/Park">
