    <!-- https://schema.org/PublicToilet -->

    <owl:Class rdf:about="https://schema.org/PublicToilet">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">A public toilet is a room or small building containing one or more toilets (and possibly also urinals) which is available for use by the general public, or by customers or employees of certain businesses.</rdfs:comment>
