<?xml version="1.0"?>
<rdf:RDF xmlns="https://schema.org/"
     xml:base="https://schema.org/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="https://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://schema.org/">
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-04</dcterms:modified>
        <rdfs:label>Schema.org Vocabulary</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">29.3</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- https://schema.org/name -->

    <owl:AnnotationProperty rdf:about="https://schema.org/name">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://schema.org/Accommodation -->

    <owl:Class rdf:about="https://schema.org/Accommodation">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment xml:lang="en">An accommodation is a place that can accommodate human beings, e.g. a hotel room, a camping pitch, or a meeting room. Many accommodations are for overnight stays, but this is not a mandatory requirement.
For more specific types of accommodations not defined in schema.org, one can use &lt;a class=&quot;localLink&quot; href=&quot;/additionalType&quot;&gt;additionalType&lt;/a&gt; with external vocabularies.
&lt;br /&gt;&lt;br /&gt;
See also the &lt;a href=&quot;/docs/hotels.html&quot;&gt;dedicated document on the use of schema.org for marking up hotels and other forms of accommodations&lt;/a&gt;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Accommodation"/>
        <rdfs:label xml:lang="en">Accommodation</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/AdministrativeArea -->

    <owl:Class rdf:about="https://schema.org/AdministrativeArea">
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment xml:lang="en">A geographical region, typically under the jurisdiction of a particular government.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:label xml:lang="en">AdministrativeArea</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Airport -->

    <owl:Class rdf:about="https://schema.org/Airport">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">An airport.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Airport"/>
        <rdfs:label xml:lang="en">Airport</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Apartment -->

    <owl:Class rdf:about="https://schema.org/Apartment">
        <rdfs:subClassOf rdf:resource="https://schema.org/Accommodation"/>
        <rdfs:comment xml:lang="en">An apartment (in American English) or flat (in British English) is a self-contained housing unit (a type of residential real estate) that occupies only part of a building (source: Wikipedia, the free encyclopedia, see &lt;a href=&quot;http://en.wikipedia.org/wiki/Apartment&quot;&gt;http://en.wikipedia.org/wiki/Apartment&lt;/a&gt;).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Apartment"/>
        <rdfs:label xml:lang="en">Apartment</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/ApartmentComplex -->

    <owl:Class rdf:about="https://schema.org/ApartmentComplex">
        <rdfs:subClassOf rdf:resource="https://schema.org/Residence"/>
        <rdfs:comment xml:lang="en">Residence type: Apartment complex.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/ApartmentComplex"/>
        <rdfs:label xml:lang="en">ApartmentComplex</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Aquarium -->

    <owl:Class rdf:about="https://schema.org/Aquarium">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">Aquarium.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Aquarium"/>
        <rdfs:label xml:lang="en">Aquarium</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Beach -->

    <owl:Class rdf:about="https://schema.org/Beach">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">Beach.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Beach"/>
        <rdfs:label xml:lang="en">Beach</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/BoatTerminal -->

    <owl:Class rdf:about="https://schema.org/BoatTerminal">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">A terminal for boats, ships, and other water vessels.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://pending.schema.org/BoatTerminal"/>
        <rdfs:label xml:lang="en">BoatTerminal</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/BodyOfWater -->

    <owl:Class rdf:about="https://schema.org/BodyOfWater">
        <rdfs:subClassOf rdf:resource="https://schema.org/Landform"/>
        <rdfs:comment xml:lang="en">A body of water, such as a sea, ocean, or lake.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/BodyOfWater"/>
        <rdfs:label xml:lang="en">BodyOfWater</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Bridge -->

    <owl:Class rdf:about="https://schema.org/Bridge">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">A bridge.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Bridge"/>
        <rdfs:label xml:lang="en">Bridge</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/BuddhistTemple -->

    <owl:Class rdf:about="https://schema.org/BuddhistTemple">
        <rdfs:subClassOf rdf:resource="https://schema.org/PlaceOfWorship"/>
        <rdfs:comment xml:lang="en">A Buddhist temple.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/BuddhistTemple"/>
        <rdfs:label xml:lang="en">BuddhistTemple</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/BusStation -->

    <owl:Class rdf:about="https://schema.org/BusStation">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">A bus station.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/BusStation"/>
        <rdfs:label xml:lang="en">BusStation</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/BusStop -->

    <owl:Class rdf:about="https://schema.org/BusStop">
        <rdfs:subClassOf rdf:resource="https://schema.org/CivicStructure"/>
        <rdfs:comment xml:lang="en">A bus stop.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/BusStop"/>
        <rdfs:label xml:lang="en">BusStop</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/CampingPitch -->

    <owl:Class rdf:about="https://schema.org/CampingPitch">
        <rdfs:subClassOf rdf:resource="https://schema.org/Accommodation"/>
        <rdfs:comment xml:lang="en">A &lt;a class=&quot;localLink&quot; href=&quot;/CampingPitch&quot;&gt;CampingPitch&lt;/a&gt; is an individual place for overnight stay in the outdoors, typically being part of a larger camping site, or &lt;a class=&quot;localLink&quot; href=&quot;/Campground&quot;&gt;Campground&lt;/a&gt;.&lt;br/&gt;&lt;br/&gt;

In British English a campsite, or campground, is an area, usually divided into a number of pitches, where people can camp overnight using tents or camper vans or caravans; this British English use of the word is synonymous with the American English expression campground. In American English the term campsite generally means an area where an individual, family, group, or military unit can pitch a tent or park a camper; a campground may contain many campsites.
(Source: Wikipedia, see &lt;a href=&quot;https://en.wikipedia.org/wiki/Campsite&quot;&gt;https://en.wikipedia.org/wiki/Campsite&lt;/a&gt;.)&lt;br/&gt;&lt;br/&gt;

See also the dedicated &lt;a href=&quot;/docs/hotels.html&quot;&gt;document on the use of schema.org for marking up hotels and other forms of accommodations&lt;/a&gt;.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/CampingPitch"/>
        <rdfs:label xml:lang="en">CampingPitch</rdfs:label>
    </owl:Class>
    


    <!-- https://schema.org/Canal -->

    <owl:Class rdf:about="https://schema.org/Canal">
        <rdfs:subClassOf rdf:resource="https://schema.org/BodyOfWater"/>
        <rdfs:comment xml:lang="en">A canal, like the Panama Canal.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://schema.org/Canal"/>
        <rdfs:label xml:lang="en">Canal</rdfs:label>
    </owl:Class>
    


